[
  {
    "_comment": "Example 1: GNSS with nanosecond sensor timestamp",
    "ser": "sensor.proto.GnssStamped",
    "schema": "foxglove.LocationFix",
    "encoding": "protobuf",
    "schema_encoding": "flatbuffers",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "header.timestamp_ns",
        "target": "timestamp",
        "time_unit": "ns"
      },
      {
        "source": "header.frame_id",
        "target": "frame_id",
        "default_value": "gnss"
      },
      {
        "source": "latitude",
        "target": "latitude"
      },
      {
        "source": "longitude",
        "target": "longitude"
      },
      {
        "source": "altitude",
        "target": "altitude"
      }
    ]
  },
  {
    "_comment": "Example 2: Odometry pose with nanosecond sensor timestamp",
    "ser": "nav.proto.OdometryStamped",
    "schema": "foxglove.PoseInFrame",
    "encoding": "protobuf",
    "schema_encoding": "flatbuffers",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "header.timestamp_ns",
        "target": "timestamp",
        "time_unit": "ns"
      },
      {
        "source": "header.frame_id",
        "target": "frame_id",
        "default_value": "odom"
      },
      {
        "source": "pose.position.x",
        "target": "pose.position.x"
      },
      {
        "source": "pose.position.y",
        "target": "pose.position.y"
      },
      {
        "source": "pose.position.z",
        "target": "pose.position.z"
      },
      {
        "source": "pose.orientation",
        "target": "pose.orientation"
      }
    ]
  },
  {
    "_comment": "Example 3: FlatBuffers lidar scan with nanosecond sensor timestamp",
    "ser": "lidar.LidarScanStamped",
    "schema": "foxglove.LaserScan",
    "encoding": "flatbuffers",
    "schema_encoding": "flatbuffers",
    "timestamp_field": "timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "timestamp_ns",
        "target": "timestamp",
        "time_unit": "ns"
      },
      {
        "source": "frame_id",
        "target": "frame_id",
        "default_value": "lidar"
      },
      {
        "source": "angle_min",
        "target": "start_angle"
      },
      {
        "source": "angle_max",
        "target": "end_angle"
      },
      {
        "source": "ranges",
        "target": "ranges"
      },
      {
        "source": "intensities",
        "target": "intensities"
      }
    ]
  },
  {
    "_comment": "Example 4: Obstacle scene with nanosecond sensor timestamp (nested field)",
    "ser": "perception.proto.ObstacleListStamped",
    "schema": "foxglove.SceneUpdate",
    "encoding": "protobuf",
    "schema_encoding": "flatbuffers",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "target": "entities[0].id",
        "default_value": "objects"
      },
      {
        "source": "header.timestamp_ns",
        "target": "entities[0].timestamp",
        "time_unit": "ns"
      },
      {
        "source": "header.frame_id",
        "target": "entities[0].frame_id",
        "default_value": "base_link"
      },
      {
        "source": "obstacles",
        "target": "entities[0].cubes"
      },
      {
        "source": "center.x",
        "target": "entities[0].cubes[].pose.position.x"
      },
      {
        "source": "center.y",
        "target": "entities[0].cubes[].pose.position.y"
      },
      {
        "source": "center.z",
        "target": "entities[0].cubes[].pose.position.z"
      },
      {
        "source": "width",
        "target": "entities[0].cubes[].size.x"
      },
      {
        "source": "length",
        "target": "entities[0].cubes[].size.y"
      },
      {
        "source": "height",
        "target": "entities[0].cubes[].size.z"
      },
      {
        "target": "entities[0].cubes[].pose.orientation.z",
        "expression": "sin((heading) * 0.5)"
      },
      {
        "target": "entities[0].cubes[].pose.orientation.w",
        "expression": "cos((heading) * 0.5)"
      }
    ]
  }
]
