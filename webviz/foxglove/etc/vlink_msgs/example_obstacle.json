{
  "ser": "perception.ObstacleList",
  "schema": "foxglove.SceneUpdate",
  "encoding": "flatbuffers",
  "schema_encoding": "flatbuffers",
  "field_mappings": [
    {
      "target": "entities[0].id",
      "default_value": "objects"
    },
    {
      "source": "timestamp_us",
      "target": "entities[0].timestamp",
      "time_unit": "us"
    },
    {
      "source": "frame_id",
      "target": "entities[0].frame_id",
      "default_value": "base_link"
    },
    {
      "source": "obstacles",
      "target": "entities[0].cubes"
    },
    {
      "source": "center.x",
      "target": "entities[0].cubes[].pose.position.x"
    },
    {
      "source": "center.y",
      "target": "entities[0].cubes[].pose.position.y"
    },
    {
      "source": "center.z",
      "target": "entities[0].cubes[].pose.position.z"
    },
    {
      "source": "width",
      "target": "entities[0].cubes[].size.x"
    },
    {
      "source": "length",
      "target": "entities[0].cubes[].size.y"
    },
    {
      "source": "height",
      "target": "entities[0].cubes[].size.z"
    },
    {
      "target": "entities[0].cubes[].pose.orientation.z",
      "expression": "sin(heading * 0.5)"
    },
    {
      "target": "entities[0].cubes[].pose.orientation.w",
      "expression": "cos(heading * 0.5)"
    }
  ]
}
