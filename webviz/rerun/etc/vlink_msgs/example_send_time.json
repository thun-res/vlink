[
  {
    "_comment": "Protobuf: send_time tags the logged TextLog row with vlink_time; it is not a standalone event",
    "ser": "system.proto.TimeSync",
    "converter": "send_time",
    "encoding": "protobuf",
    "timestamp_field": "timestamp_ns",
    "timestamp_unit": "ns"
  },
  {
    "ser": "system.proto.TimeSync",
    "archetype": "TextLog",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "target": "message",
        "default_value": "time sync"
      }
    ]
  },
  {
    "_comment": "FlatBuffers: pair send_time with an archetype mapping for the same message",
    "ser": "system.TimeSyncFbs",
    "converter": "send_time",
    "encoding": "flatbuffers",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns"
  },
  {
    "ser": "system.TimeSyncFbs",
    "archetype": "TextLog",
    "encoding": "flatbuffers",
    "field_mappings": [
      {
        "target": "message",
        "default_value": "time sync"
      }
    ]
  }
]
