[
  {
    "_comment": "Example 1: GNSS with nanosecond sensor timestamp",
    "ser": "sensor.proto.GnssStamped",
    "archetype": "GeoPoints",
    "encoding": "protobuf",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "latitude",
        "target": "positions[0][0]"
      },
      {
        "source": "longitude",
        "target": "positions[0][1]"
      }
    ]
  },
  {
    "_comment": "Example 2: Odometry pose with nanosecond sensor timestamp",
    "ser": "nav.proto.OdometryStamped",
    "archetype": "Transform3D",
    "encoding": "protobuf",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "pose.position.x",
        "target": "translation[0]"
      },
      {
        "source": "pose.position.y",
        "target": "translation[1]"
      },
      {
        "source": "pose.position.z",
        "target": "translation[2]"
      },
      {
        "target": "quaternion[0]",
        "source": "pose.orientation.x",
        "default_value": 0
      },
      {
        "target": "quaternion[1]",
        "source": "pose.orientation.y",
        "default_value": 0
      },
      {
        "target": "quaternion[2]",
        "source": "pose.orientation.z",
        "default_value": 0
      },
      {
        "target": "quaternion[3]",
        "source": "pose.orientation.w",
        "default_value": 1
      }
    ]
  },
  {
    "_comment": "Example 3: Protobuf lidar scan with nanosecond sensor timestamp",
    "ser": "lidar.proto.LidarScanStamped",
    "archetype": "Points3D",
    "encoding": "protobuf",
    "timestamp_field": "timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "target": "positions",
        "source": "ranges"
      },
      {
        "target": "positions[][0]",
        "expression": "_value * cos(_root.angle_min + _index * if(_root.angle_increment != 0, _root.angle_increment, (_root.angle_max - _root.angle_min) / max(1, _root.ranges._size - 1)))"
      },
      {
        "target": "positions[][1]",
        "expression": "_value * sin(_root.angle_min + _index * if(_root.angle_increment != 0, _root.angle_increment, (_root.angle_max - _root.angle_min) / max(1, _root.ranges._size - 1)))"
      },
      {
        "target": "positions[][2]",
        "default_value": 0
      }
    ]
  },
  {
    "_comment": "Example 4: Obstacle boxes with nanosecond sensor timestamp (nested field)",
    "ser": "perception.proto.ObstacleListStamped",
    "archetype": "Boxes3D",
    "encoding": "protobuf",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "target": "centers",
        "source": "obstacles"
      },
      {
        "target": "half_sizes",
        "source": "obstacles"
      },
      {
        "target": "quaternions",
        "source": "obstacles"
      },
      {
        "target": "centers[][0]",
        "source": "center.x",
        "default_value": 0
      },
      {
        "target": "centers[][1]",
        "source": "center.y",
        "default_value": 0
      },
      {
        "target": "centers[][2]",
        "source": "center.z",
        "default_value": 0
      },
      {
        "target": "half_sizes[][0]",
        "source": "width",
        "expression": "(width) / 2"
      },
      {
        "target": "half_sizes[][1]",
        "source": "length",
        "expression": "(length) / 2"
      },
      {
        "target": "half_sizes[][2]",
        "source": "height",
        "expression": "(height) / 2"
      },
      {
        "target": "quaternions[][0]",
        "default_value": 0
      },
      {
        "target": "quaternions[][1]",
        "default_value": 0
      },
      {
        "target": "quaternions[][2]",
        "expression": "sin((heading) / 2)"
      },
      {
        "target": "quaternions[][3]",
        "expression": "cos((heading) / 2)"
      }
    ]
  },
  {
    "_comment": "Example 5: Multiple archetypes from same message, sharing one timestamp",
    "ser": "nav.proto.VehiclePoseStamped",
    "archetype": "GeoPoints",
    "encoding": "protobuf",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "latitude",
        "target": "positions[0][0]"
      },
      {
        "source": "longitude",
        "target": "positions[0][1]"
      }
    ]
  },
  {
    "_comment": "Example 5 continued: same ser, different archetype, same timestamp config",
    "ser": "nav.proto.VehiclePoseStamped",
    "archetype": "Transform3D",
    "encoding": "protobuf",
    "timestamp_field": "header.timestamp_ns",
    "timestamp_unit": "ns",
    "field_mappings": [
      {
        "source": "pose.position.x",
        "target": "translation[0]"
      },
      {
        "source": "pose.position.y",
        "target": "translation[1]"
      },
      {
        "source": "pose.position.z",
        "target": "translation[2]"
      },
      {
        "target": "quaternion[0]",
        "source": "pose.orientation.x",
        "default_value": 0
      },
      {
        "target": "quaternion[1]",
        "source": "pose.orientation.y",
        "default_value": 0
      },
      {
        "target": "quaternion[2]",
        "source": "pose.orientation.z",
        "default_value": 0
      },
      {
        "target": "quaternion[3]",
        "source": "pose.orientation.w",
        "default_value": 1
      }
    ]
  }
]
