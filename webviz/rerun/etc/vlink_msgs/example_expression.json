[
  {
    "_comment": "Example 1: DMS to decimal degrees (multi-variable linear)",
    "ser": "sensor.proto.GnssRaw",
    "archetype": "GeoPoints",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "source": "latitude_deg",
        "target": "positions[0][0]",
        "expression": "latitude_deg + latitude_min / 60.0 + latitude_sec / 3600.0"
      },
      {
        "source": "longitude_deg",
        "target": "positions[0][1]",
        "expression": "longitude_deg + longitude_min / 60.0 + longitude_sec / 3600.0"
      }
    ]
  },
  {
    "_comment": "Example 2: Nested fields + direct quaternion pose",
    "ser": "nav.proto.Odometry",
    "archetype": "Transform3D",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "source": "pose.position.x",
        "target": "translation[0]"
      },
      {
        "source": "pose.position.y",
        "target": "translation[1]"
      },
      {
        "source": "pose.position.z",
        "target": "translation[2]"
      },
      {
        "target": "quaternion[0]",
        "source": "pose.orientation.x",
        "default_value": 0
      },
      {
        "target": "quaternion[1]",
        "source": "pose.orientation.y",
        "default_value": 0
      },
      {
        "target": "quaternion[2]",
        "source": "pose.orientation.z",
        "default_value": 0
      },
      {
        "target": "quaternion[3]",
        "source": "pose.orientation.w",
        "default_value": 1
      }
    ]
  },
  {
    "_comment": "Example 3: Distance + velocity norm (sqrt, pow, multi-variable)",
    "ser": "nav.proto.VehicleState",
    "archetype": "Scalars",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "source": "position.x",
        "target": "scalars",
        "_comment": "2D distance from origin",
        "expression": "sqrt(position.x^2 + position.y^2)"
      }
    ]
  },
  {
    "_comment": "Example 4: Conditional expression (if/else, clamp, unit conversion)",
    "ser": "control.proto.SteeringCmd",
    "archetype": "Scalars",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "source": "steering_angle_rad",
        "target": "scalars",
        "_comment": "Radians to degrees, clamped to [-45, 45]",
        "expression": "clamp(-45.0, steering_angle_rad * 180.0 / pi, 45.0)"
      }
    ]
  },
  {
    "_comment": "Example 5: Euler normalization into translation axes",
    "ser": "sensor.proto.ImuProcessed",
    "archetype": "Transform3D",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "source": "roll_rad",
        "target": "translation[0]",
        "_comment": "Roll normalized to [-180, 180] degrees",
        "expression": "atan2(sin(roll_rad), cos(roll_rad)) * 180.0 / pi"
      },
      {
        "source": "pitch_rad",
        "target": "translation[1]",
        "_comment": "Pitch clamped to [-90, 90] degrees",
        "expression": "clamp(-90.0, pitch_rad * 180.0 / pi, 90.0)"
      },
      {
        "source": "yaw_rad",
        "target": "translation[2]",
        "_comment": "Yaw in [0, 360) degrees",
        "expression": "((atan2(sin(yaw_rad), cos(yaw_rad)) * 180.0 / pi) + 360) % 360"
      }
    ]
  },
  {
    "_comment": "Example 6: Obstacle box transform with fallback heading",
    "ser": "perception.proto.ObstacleStamped",
    "archetype": "Boxes3D",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "target": "centers",
        "source": "obstacles"
      },
      {
        "target": "half_sizes",
        "source": "obstacles"
      },
      {
        "target": "quaternions",
        "source": "obstacles"
      },
      {
        "target": "centers[][0]",
        "source": "center.x",
        "default_value": 0
      },
      {
        "target": "centers[][1]",
        "source": "center.y",
        "default_value": 0
      },
      {
        "target": "centers[][2]",
        "source": "center.z",
        "default_value": 0,
        "expression": "center.z + height / 2.0"
      },
      {
        "target": "half_sizes[][0]",
        "source": "width",
        "expression": "(max(width, 0.5)) / 2"
      },
      {
        "target": "half_sizes[][1]",
        "source": "length",
        "expression": "(max(length, 0.5)) / 2"
      },
      {
        "target": "half_sizes[][2]",
        "source": "height",
        "expression": "(max(height, 0.3)) / 2"
      },
      {
        "target": "quaternions[][0]",
        "default_value": 0
      },
      {
        "target": "quaternions[][1]",
        "default_value": 0
      },
      {
        "target": "quaternions[][2]",
        "expression": "sin((if(abs(heading) > 0.001, heading, atan2(velocity.y, velocity.x))) / 2)"
      },
      {
        "target": "quaternions[][3]",
        "expression": "cos((if(abs(heading) > 0.001, heading, atan2(velocity.y, velocity.x))) / 2)"
      }
    ]
  },
  {
    "_comment": "Example 7: Simple lat/lon passthrough",
    "ser": "sensor.proto.GnssFix",
    "archetype": "GeoPoints",
    "encoding": "protobuf",
    "field_mappings": [
      {
        "source": "latitude",
        "target": "positions[0][0]"
      },
      {
        "source": "longitude",
        "target": "positions[0][1]"
      }
    ]
  }
]
