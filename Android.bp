// libvlink-defaults
cc_defaults {
    name: "libvlink-defaults",
    cppflags: [
        "-fexceptions",
        "-Wno-non-virtual-dtor",
        "-Wno-unknown-pragmas",
        "-Wno-implicit-fallthrough",
        "-Wno-unused-parameter",
        "-fvisibility=hidden",
    ],
    cpp_std: "c++17",
}

// libvlink
cc_library_shared {
    name: "libvlink",
    defaults: [
        "libvlink-defaults",
    ],
    // vendor_available: true,
    srcs: [
        "src/base/*.cc",
        "src/extension/*.cc",
        "src/impl/*.cc",
        "src/private/*.cc",
        "src/zerocopy/*.cc",
    ],
    local_include_dirs: [
        "include",
        "include/vlink",
        "thirdparty/lzav/include",
        "thirdparty/json/include",
        "thirdparty/mcap/include",
        "thirdparty/robin-map/include",
    ],
    export_include_dirs: [
        "include",
    ],
    shared_libs: [
        "liblog",
        "libcrypto",
        "libsqlite",
    ],
    static_libs: [
        "libc++fs",
    ],
    cppflags: [
        "-DVLINK_LIBRARY",
        "-DVLINK_ENABLE_SECURITY",
        "-DVLINK_ENABLE_SQLITE",
    ],
}

// libvlink-intra
cc_library_shared {
    name: "libvlink-intra",
    defaults: [
        "libvlink-defaults",
    ],
    // vendor_available: true,
    srcs: [
        "src/transports/intra/*.cc",
    ],
    local_include_dirs: [
        "src/transports/intra",
        "include/vlink",
    ],
    cppflags: [
        "-DVLINK_LIBRARY",
        "-DVLINK_SUPPORT_INTRA",
    ],
    shared_libs: [
        "libvlink",
    ],
}

// libvlink-dds
cc_defaults {
    name: "libvlink-dds-defaults",
    defaults: [
        "libvlink-defaults",
    ],
    local_include_dirs: [
        "src/transports/dds",
        "src/transports/dds/builtin",
        "include/vlink",
    ],
    cppflags: [
        "-DVLINK_LIBRARY",
        "-DVLINK_SUPPORT_DDS",
    ],
    shared_libs: [
        "libvlink",
        "libfastrtps",
        "libfastcdr",
    ],
}

// Fast DDS uses dynamic_cast when registering these TopicDataType subclasses.
cc_library_static {
    name: "libvlink-dds-types",
    defaults: ["libvlink-dds-defaults"],
    // vendor_available: true,
    rtti: true,
    srcs: [
        "src/transports/dds/dds_topic.cc",
        "src/transports/dds/builtin/2_x/BuiltInRawPubSubTypes.cxx",
    ],
}

cc_library_shared {
    name: "libvlink-dds",
    defaults: ["libvlink-dds-defaults"],
    // vendor_available: true,
    srcs: [
        "src/transports/dds/*.cc",
        "src/transports/dds/builtin/2_x/BuiltInRaw.cxx",
    ],
    exclude_srcs: ["src/transports/dds/dds_topic.cc"],
    static_libs: ["libvlink-dds-types"],
}

// libvlink-ddsc
cc_library_shared {
    name: "libvlink-ddsc",
    defaults: [
        "libvlink-defaults",
    ],
    // vendor_available: true,
    srcs: [
        "src/transports/ddsc/*.cc",
        "src/transports/ddsc/builtin/*.c",
    ],
    local_include_dirs: [
        "src/transports/ddsc",
        "src/transports/ddsc/builtin",
        "include/vlink",
    ],
    cppflags: [
        "-DVLINK_LIBRARY",
        "-DVLINK_SUPPORT_DDSC",
    ],
    shared_libs: [
        "libvlink",
        "libcyclonedds",
    ],
}

// libvlink-c_api
cc_library_shared {
    name: "libvlink-c_api",
    defaults: [
        "libvlink-defaults",
    ],
    // vendor_available: true,
    srcs: [
        "src/external/c_api/*.cc",
    ],
    local_include_dirs: [
        "include/vlink",
    ],
    cppflags: [
        "-DVLINK_C_API_LIBRARY",
        "-DVLINK_ENABLE_C_INTERFACE",
        "-DVLINK_SUPPORT_INTRA",
        "-DVLINK_SUPPORT_DDS",
        "-DVLINK_SUPPORT_DDSC",
    ],
    shared_libs: [
        "libvlink",
        "libvlink-intra",
        "libvlink-dds",
        "libvlink-ddsc",
    ],
}

