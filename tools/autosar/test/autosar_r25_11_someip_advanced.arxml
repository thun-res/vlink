<?xml version="1.0" encoding="UTF-8"?>
<!-- R25-11 advanced type fixture for the VLink SOME/IP generator tests. -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00054.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Advanced</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>PlatformTypes</SHORT-NAME>
          <ELEMENTS>
            <SW-BASE-TYPE>
              <SHORT-NAME>uint8</SHORT-NAME><CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <NATIVE-DECLARATION>uint8</NATIVE-DECLARATION>
            </SW-BASE-TYPE>
            <SW-BASE-TYPE>
              <SHORT-NAME>uint16</SHORT-NAME><CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <NATIVE-DECLARATION>uint16</NATIVE-DECLARATION>
            </SW-BASE-TYPE>
            <SW-BASE-TYPE>
              <SHORT-NAME>uint32</SHORT-NAME><CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>32</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <NATIVE-DECLARATION>uint32</NATIVE-DECLARATION>
            </SW-BASE-TYPE>
            <SW-BASE-TYPE>
              <SHORT-NAME>Utf8</SHORT-NAME><CATEGORY>VARIABLE_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>UTF-8</BASE-TYPE-ENCODING>
            </SW-BASE-TYPE>
            <SW-BASE-TYPE>
              <SHORT-NAME>Utf16</SHORT-NAME><CATEGORY>VARIABLE_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>UTF-16</BASE-TYPE-ENCODING>
            </SW-BASE-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>ImplementationTypes</SHORT-NAME>
          <ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Lookup</SHORT-NAME><CATEGORY>ASSOCIATIVE_MAP</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>key</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint16</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>value</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint32</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Choice</SHORT-NAME><CATEGORY>UNION</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>small</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint16</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>large</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint32</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Cube</SHORT-NAME><CATEGORY>ARRAY</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>plane</SHORT-NAME><CATEGORY>ARRAY</CATEGORY>
                  <ARRAY-SIZE>2</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SUB-ELEMENTS>
                    <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                      <SHORT-NAME>row</SHORT-NAME><CATEGORY>ARRAY</CATEGORY>
                      <ARRAY-SIZE>2</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                      <SUB-ELEMENTS>
                        <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                          <SHORT-NAME>cell</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                          <ARRAY-SIZE>2</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                          <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS>
                            <SW-DATA-DEF-PROPS-CONDITIONAL>
                              <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint8</BASE-TYPE-REF>
                            </SW-DATA-DEF-PROPS-CONDITIONAL>
                          </SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                        </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                      </SUB-ELEMENTS>
                    </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  </SUB-ELEMENTS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>RecordArray</SHORT-NAME><CATEGORY>ARRAY</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>record</SHORT-NAME><CATEGORY>STRUCTURE</CATEGORY>
                  <ARRAY-SIZE>2</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SUB-ELEMENTS>
                    <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                      <SHORT-NAME>value</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                      <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS>
                        <SW-DATA-DEF-PROPS-CONDITIONAL>
                          <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint8</BASE-TYPE-REF>
                        </SW-DATA-DEF-PROPS-CONDITIONAL>
                      </SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                    </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  </SUB-ELEMENTS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>AdvancedPayload</SHORT-NAME><CATEGORY>STRUCTURE</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>title</SHORT-NAME><CATEGORY>STRING</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <SW-TEXT-PROPS>
                      <SW-MAX-TEXT-SIZE>4</SW-MAX-TEXT-SIZE>
                      <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/Utf16</BASE-TYPE-REF>
                    </SW-TEXT-PROPS>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>lookup</SHORT-NAME><CATEGORY>TYPE_REFERENCE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/Lookup</IMPLEMENTATION-DATA-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>samples</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <ARRAY-SIZE>2</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>VARIABLE-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint16</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>choice</SHORT-NAME><CATEGORY>TYPE_REFERENCE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/Choice</IMPLEMENTATION-DATA-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>TlvPayload</SHORT-NAME><CATEGORY>STRUCTURE</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>label</SHORT-NAME><CATEGORY>STRING</CATEGORY><IS-OPTIONAL>true</IS-OPTIONAL>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <SW-TEXT-PROPS>
                      <SW-MAX-TEXT-SIZE>4</SW-MAX-TEXT-SIZE>
                      <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/Utf8</BASE-TYPE-REF>
                    </SW-TEXT-PROPS>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>code</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Advanced/PlatformTypes/uint8</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>lookup</SHORT-NAME><CATEGORY>TYPE_REFERENCE</CATEGORY><IS-OPTIONAL>true</IS-OPTIONAL>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/Lookup</IMPLEMENTATION-DATA-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>values</SHORT-NAME><CATEGORY>TYPE_REFERENCE</CATEGORY><IS-OPTIONAL>true</IS-OPTIONAL>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/Cube</IMPLEMENTATION-DATA-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>records</SHORT-NAME><CATEGORY>TYPE_REFERENCE</CATEGORY><IS-OPTIONAL>true</IS-OPTIONAL>
                  <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/RecordArray</IMPLEMENTATION-DATA-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>ServiceInterfaces</SHORT-NAME>
          <ELEMENTS>
            <SERVICE-INTERFACE>
              <SHORT-NAME>AdvancedService</SHORT-NAME>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>Event</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/AdvancedPayload</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>TlvEvent</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Advanced/ImplementationTypes/TlvPayload</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
            </SERVICE-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>SomeipDeployment</SHORT-NAME>
          <ELEMENTS>
            <TLV-DATA-ID-DEFINITION-SET>
              <SHORT-NAME>TlvDataIds</SHORT-NAME>
              <TLV-DATA-ID-DEFINITIONS>
                <TLV-DATA-ID-DEFINITION>
                  <ID>1</ID>
                  <TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF DEST="IMPLEMENTATION-DATA-TYPE-ELEMENT">/Advanced/ImplementationTypes/TlvPayload/label</TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF>
                </TLV-DATA-ID-DEFINITION>
                <TLV-DATA-ID-DEFINITION>
                  <ID>2</ID>
                  <TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF DEST="IMPLEMENTATION-DATA-TYPE-ELEMENT">/Advanced/ImplementationTypes/TlvPayload/code</TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF>
                </TLV-DATA-ID-DEFINITION>
                <TLV-DATA-ID-DEFINITION>
                  <ID>3</ID>
                  <TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF DEST="IMPLEMENTATION-DATA-TYPE-ELEMENT">/Advanced/ImplementationTypes/TlvPayload/lookup</TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF>
                </TLV-DATA-ID-DEFINITION>
                <TLV-DATA-ID-DEFINITION>
                  <ID>4</ID>
                  <TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF DEST="IMPLEMENTATION-DATA-TYPE-ELEMENT">/Advanced/ImplementationTypes/TlvPayload/values</TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF>
                </TLV-DATA-ID-DEFINITION>
                <TLV-DATA-ID-DEFINITION>
                  <ID>5</ID>
                  <TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF DEST="IMPLEMENTATION-DATA-TYPE-ELEMENT">/Advanced/ImplementationTypes/TlvPayload/records</TLV-IMPLEMENTATION-DATA-TYPE-ELEMENT-REF>
                </TLV-DATA-ID-DEFINITION>
              </TLV-DATA-ID-DEFINITIONS>
            </TLV-DATA-ID-DEFINITION-SET>
            <TRANSFORMATION-PROPS-SET>
              <SHORT-NAME>AdvancedTransformationProps</SHORT-NAME>
              <TRANSFORMATION-PROPSS>
                <AP-SOMEIP-TRANSFORMATION-PROPS>
                  <SHORT-NAME>Defaults</SHORT-NAME>
                  <SIZE-OF-ARRAY-LENGTH-FIELD>2</SIZE-OF-ARRAY-LENGTH-FIELD>
                  <SIZE-OF-STRING-LENGTH-FIELD>2</SIZE-OF-STRING-LENGTH-FIELD>
                  <SIZE-OF-STRUCT-LENGTH-FIELD>2</SIZE-OF-STRUCT-LENGTH-FIELD>
                  <SIZE-OF-UNION-LENGTH-FIELD>2</SIZE-OF-UNION-LENGTH-FIELD>
                  <SIZE-OF-UNION-TYPE-SELECTOR-FIELD>1</SIZE-OF-UNION-TYPE-SELECTOR-FIELD>
                  <STRING-ENCODING>UTF-16BE</STRING-ENCODING>
                </AP-SOMEIP-TRANSFORMATION-PROPS>
                <AP-SOMEIP-TRANSFORMATION-PROPS>
                  <SHORT-NAME>TlvDefaults</SHORT-NAME>
                  <SIZE-OF-ARRAY-LENGTH-FIELD>2</SIZE-OF-ARRAY-LENGTH-FIELD>
                  <SIZE-OF-STRING-LENGTH-FIELD>2</SIZE-OF-STRING-LENGTH-FIELD>
                  <SIZE-OF-STRUCT-LENGTH-FIELD>2</SIZE-OF-STRUCT-LENGTH-FIELD>
                  <SIZE-OF-UNION-LENGTH-FIELD>2</SIZE-OF-UNION-LENGTH-FIELD>
                </AP-SOMEIP-TRANSFORMATION-PROPS>
              </TRANSFORMATION-PROPSS>
            </TRANSFORMATION-PROPS-SET>
            <TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
              <SHORT-NAME>EventMapping</SHORT-NAME>
              <EVENT-REFS><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Advanced/ServiceInterfaces/AdvancedService/Event</EVENT-REF></EVENT-REFS>
              <TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/Advanced/SomeipDeployment/AdvancedTransformationProps/Defaults</TRANSFORMATION-PROPS-REF>
            </TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
            <TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
              <SHORT-NAME>TlvEventMapping</SHORT-NAME>
              <EVENT-REFS><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Advanced/ServiceInterfaces/AdvancedService/TlvEvent</EVENT-REF></EVENT-REFS>
              <TLV-DATA-ID-DEFINITION-REFS>
                <TLV-DATA-ID-DEFINITION-REF DEST="TLV-DATA-ID-DEFINITION-SET">/Advanced/SomeipDeployment/TlvDataIds</TLV-DATA-ID-DEFINITION-REF>
              </TLV-DATA-ID-DEFINITION-REFS>
              <TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/Advanced/SomeipDeployment/AdvancedTransformationProps/TlvDefaults</TRANSFORMATION-PROPS-REF>
            </TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
