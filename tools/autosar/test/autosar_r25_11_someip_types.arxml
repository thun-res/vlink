        <AR-PACKAGE>
          <SHORT-NAME>SomeipDeployment</SHORT-NAME>
          <ELEMENTS>
            <TRANSFORMATION-PROPS-SET>
              <SHORT-NAME>VehicleStateTransformationProps</SHORT-NAME>
