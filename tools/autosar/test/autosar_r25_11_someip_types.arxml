            </TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
            <SOMEIP-DATA-PROTOTYPE-TRANSFORMATION-PROPS>
              <SHORT-NAME>SampleWindowDeployment</SHORT-NAME>
              <DATA-PROTOTYPES>
                <DATA-PROTOTYPE-IN-SERVICE-INTERFACE-REF>
                  <DATA-PROTOTYPE-IREF>
                    <ROOT-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/VLink/ServiceInterfaces/VehicleStateService/VehicleStateEvent</ROOT-DATA-PROTOTYPE-REF>
                    <TARGET-DATA-PROTOTYPE-REF DEST="APPLICATION-RECORD-ELEMENT">/VLink/ApplicationTypes/VehicleStateApplication/samples</TARGET-DATA-PROTOTYPE-REF>
                  </DATA-PROTOTYPE-IREF>
                </DATA-PROTOTYPE-IN-SERVICE-INTERFACE-REF>
              </DATA-PROTOTYPES>
              <SOMEIP-TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/VLink/SomeipDeployment/VehicleStateTransformationProps/FixedArrayWithoutLength</SOMEIP-TRANSFORMATION-PROPS-REF>
            </SOMEIP-DATA-PROTOTYPE-TRANSFORMATION-PROPS>
            <SOMEIP-DATA-PROTOTYPE-TRANSFORMATION-PROPS>
              <SHORT-NAME>ObjectListDeployment</SHORT-NAME>
              <DATA-PROTOTYPES>
                <DATA-PROTOTYPE-IN-SERVICE-INTERFACE-REF>
                  <DATA-PROTOTYPE-IREF>
                    <ROOT-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/VLink/ServiceInterfaces/VehicleStateService/VehicleStateEvent</ROOT-DATA-PROTOTYPE-REF>
                    <TARGET-DATA-PROTOTYPE-REF DEST="APPLICATION-RECORD-ELEMENT">/VLink/ApplicationTypes/VehicleStateApplication/objects</TARGET-DATA-PROTOTYPE-REF>
                  </DATA-PROTOTYPE-IREF>
                </DATA-PROTOTYPE-IN-SERVICE-INTERFACE-REF>
              </DATA-PROTOTYPES>
              <SOMEIP-TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/VLink/SomeipDeployment/VehicleStateTransformationProps/TwoByteArrayLength</SOMEIP-TRANSFORMATION-PROPS-REF>
            </SOMEIP-DATA-PROTOTYPE-TRANSFORMATION-PROPS>
            <SOMEIP-DATA-PROTOTYPE-TRANSFORMATION-PROPS>
              <SHORT-NAME>PayloadBytesDeployment</SHORT-NAME>
              <DATA-PROTOTYPES>
                <DATA-PROTOTYPE-IN-SERVICE-INTERFACE-REF>
                  <DATA-PROTOTYPE-IREF>
                    <ROOT-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/VLink/ServiceInterfaces/VehicleStateService/VehicleStateEvent</ROOT-DATA-PROTOTYPE-REF>
                    <TARGET-DATA-PROTOTYPE-REF DEST="APPLICATION-RECORD-ELEMENT">/VLink/ApplicationTypes/VehicleStateApplication/payload</TARGET-DATA-PROTOTYPE-REF>
                  </DATA-PROTOTYPE-IREF>
                </DATA-PROTOTYPE-IN-SERVICE-INTERFACE-REF>
              </DATA-PROTOTYPES>
              <SOMEIP-TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/VLink/SomeipDeployment/VehicleStateTransformationProps/OneByteArrayLength</SOMEIP-TRANSFORMATION-PROPS-REF>
            </SOMEIP-DATA-PROTOTYPE-TRANSFORMATION-PROPS>
          </ELEMENTS>
        </AR-PACKAGE>
