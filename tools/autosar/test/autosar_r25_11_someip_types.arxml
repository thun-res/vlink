        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>ServiceInterfaces</SHORT-NAME>
          <ELEMENTS>
            <CONSTANT-SPECIFICATION>
              <SHORT-NAME>InitialSequence</SHORT-NAME>
              <VALUE-SPEC>
                <NUMERICAL-VALUE-SPECIFICATION><VALUE>7</VALUE></NUMERICAL-VALUE-SPECIFICATION>
              </VALUE-SPEC>
            </CONSTANT-SPECIFICATION>
            <SERVICE-INTERFACE>
              <SHORT-NAME>VehicleStateService</SHORT-NAME>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VehicleStateEvent</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/VLink/ApplicationTypes/VehicleStateApplication</TYPE-TREF>
                  <INIT-VALUE>
                    <RECORD-VALUE-SPECIFICATION>
                      <FIELDS>
                        <CONSTANT-REFERENCE>
                          <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/VLink/ServiceInterfaces/InitialSequence</CONSTANT-REF>
                        </CONSTANT-REFERENCE>
                        <NUMERICAL-VALUE-SPECIFICATION><VALUE>true</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                        <APPLICATION-VALUE-SPECIFICATION>
                          <CATEGORY>VALUE</CATEGORY>
                          <SW-VALUE-CONT>
                            <SW-VALUES-PHYS><VT>drive</VT></SW-VALUES-PHYS>
                          </SW-VALUE-CONT>
                        </APPLICATION-VALUE-SPECIFICATION>
                        <NUMERICAL-VALUE-SPECIFICATION><VALUE>20.5</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                        <TEXT-VALUE-SPECIFICATION><VALUE>parked</VALUE></TEXT-VALUE-SPECIFICATION>
                        <RECORD-VALUE-SPECIFICATION>
                          <FIELDS>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>-5</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>8</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                          </FIELDS>
                        </RECORD-VALUE-SPECIFICATION>
                        <ARRAY-VALUE-SPECIFICATION>
                          <ELEMENTS>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>10</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>20</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>30</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>40</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                          </ELEMENTS>
                        </ARRAY-VALUE-SPECIFICATION>
                        <ARRAY-VALUE-SPECIFICATION>
                          <ELEMENTS>
                            <RECORD-VALUE-SPECIFICATION>
                              <FIELDS>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>1</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>2</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                              </FIELDS>
                            </RECORD-VALUE-SPECIFICATION>
                            <RECORD-VALUE-SPECIFICATION>
                              <FIELDS>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>-3</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>4</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                              </FIELDS>
                            </RECORD-VALUE-SPECIFICATION>
                          </ELEMENTS>
                        </ARRAY-VALUE-SPECIFICATION>
                        <ARRAY-VALUE-SPECIFICATION>
                          <ELEMENTS>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>0xDE</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>0xAD</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>0xBE</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                            <NUMERICAL-VALUE-SPECIFICATION><VALUE>0xEF</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                          </ELEMENTS>
                        </ARRAY-VALUE-SPECIFICATION>
                        <ARRAY-VALUE-SPECIFICATION>
                          <ELEMENTS>
                            <ARRAY-VALUE-SPECIFICATION>
                              <ELEMENTS>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>1</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>2</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>3</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                              </ELEMENTS>
                            </ARRAY-VALUE-SPECIFICATION>
                            <ARRAY-VALUE-SPECIFICATION>
                              <ELEMENTS>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>4</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>5</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                                <NUMERICAL-VALUE-SPECIFICATION><VALUE>6</VALUE></NUMERICAL-VALUE-SPECIFICATION>
                              </ELEMENTS>
                            </ARRAY-VALUE-SPECIFICATION>
                          </ELEMENTS>
                        </ARRAY-VALUE-SPECIFICATION>
                      </FIELDS>
                    </RECORD-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
            </SERVICE-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>ApplicationTypes</SHORT-NAME>
          <ELEMENTS>
            <APPLICATION-PRIMITIVE-DATA-TYPE>
