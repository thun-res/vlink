                </APPLICATION-RECORD-ELEMENT>
                <APPLICATION-RECORD-ELEMENT>
                  <SHORT-NAME>temperature</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/AUTOSAR/PlatformTypes/float32</TYPE-TREF>
