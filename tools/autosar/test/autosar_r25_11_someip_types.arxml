                          <BASE-TYPE-REF DEST="SW-BASE-TYPE">/VLink/PlatformTypes/Utf8</BASE-TYPE-REF>
                        </SW-TEXT-PROPS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
