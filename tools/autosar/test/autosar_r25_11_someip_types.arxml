              <ELEMENT>
                <SHORT-NAME>element</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
                <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/AUTOSAR/PlatformTypes/uint16</TYPE-TREF>
                <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                <MAX-NUMBER-OF-ELEMENTS>4</MAX-NUMBER-OF-ELEMENTS>
              </ELEMENT>
            </APPLICATION-ARRAY-DATA-TYPE>
            <APPLICATION-ARRAY-DATA-TYPE>
              <SHORT-NAME>ObjectListApplication</SHORT-NAME><CATEGORY>ARRAY</CATEGORY>
              <ELEMENT>
                <SHORT-NAME>element</SHORT-NAME><CATEGORY>TYPE_REFERENCE</CATEGORY>
                <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/VLink/ApplicationTypes/PositionApplication</TYPE-TREF>
                <ARRAY-SIZE-SEMANTICS>VARIABLE-SIZE</ARRAY-SIZE-SEMANTICS>
