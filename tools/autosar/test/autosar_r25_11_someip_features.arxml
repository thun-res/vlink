<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES><AR-PACKAGE><SHORT-NAME>Features</SHORT-NAME><ELEMENTS>
    <SW-BASE-TYPE><SHORT-NAME>uint8</SHORT-NAME><BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
      <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING></SW-BASE-TYPE>
    <SW-BASE-TYPE><SHORT-NAME>uint16</SHORT-NAME><BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
      <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING></SW-BASE-TYPE>
    <SW-BASE-TYPE><SHORT-NAME>Utf8</SHORT-NAME><BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
      <BASE-TYPE-ENCODING>UTF-8</BASE-TYPE-ENCODING></SW-BASE-TYPE>
    <SW-BASE-TYPE><SHORT-NAME>Utf16</SHORT-NAME><BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
      <BASE-TYPE-ENCODING>UTF-16</BASE-TYPE-ENCODING></SW-BASE-TYPE>
    <APPLICATION-PRIMITIVE-DATA-TYPE><SHORT-NAME>Text8</SHORT-NAME><CATEGORY>STRING</CATEGORY>
      <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL><SW-TEXT-PROPS>
        <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS><SW-MAX-TEXT-SIZE>4</SW-MAX-TEXT-SIZE>
        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Features/Utf8</BASE-TYPE-REF>
      </SW-TEXT-PROPS></SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
    </APPLICATION-PRIMITIVE-DATA-TYPE>
    <APPLICATION-PRIMITIVE-DATA-TYPE><SHORT-NAME>Text16</SHORT-NAME><CATEGORY>STRING</CATEGORY>
      <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL><SW-TEXT-PROPS>
        <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS><SW-MAX-TEXT-SIZE>3</SW-MAX-TEXT-SIZE>
        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Features/Utf16</BASE-TYPE-REF>
      </SW-TEXT-PROPS></SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
    </APPLICATION-PRIMITIVE-DATA-TYPE>
    <IMPLEMENTATION-DATA-TYPE><SHORT-NAME>Text8Storage</SHORT-NAME><CATEGORY>ARRAY</CATEGORY><SUB-ELEMENTS>
      <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>element</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
        <ARRAY-SIZE>8</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
        <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
          <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Features/uint8</BASE-TYPE-REF>
        </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
      </IMPLEMENTATION-DATA-TYPE-ELEMENT>
    </SUB-ELEMENTS></IMPLEMENTATION-DATA-TYPE>
    <IMPLEMENTATION-DATA-TYPE><SHORT-NAME>Text16Storage</SHORT-NAME><CATEGORY>ARRAY</CATEGORY><SUB-ELEMENTS>
      <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>element</SHORT-NAME><CATEGORY>VALUE</CATEGORY>
        <ARRAY-SIZE>4</ARRAY-SIZE><ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
        <SW-DATA-DEF-PROPS><SW-DATA-DEF-PROPS-VARIANTS><SW-DATA-DEF-PROPS-CONDITIONAL>
          <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Features/uint16</BASE-TYPE-REF>
        </SW-DATA-DEF-PROPS-CONDITIONAL></SW-DATA-DEF-PROPS-VARIANTS></SW-DATA-DEF-PROPS>
      </IMPLEMENTATION-DATA-TYPE-ELEMENT>
    </SUB-ELEMENTS></IMPLEMENTATION-DATA-TYPE>
    <APPLICATION-RECORD-DATA-TYPE><SHORT-NAME>Payload</SHORT-NAME><ELEMENTS>
      <APPLICATION-RECORD-ELEMENT><SHORT-NAME>text8</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text8</TYPE-TREF>
      </APPLICATION-RECORD-ELEMENT>
      <APPLICATION-RECORD-ELEMENT><SHORT-NAME>text16</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text16</TYPE-TREF>
      </APPLICATION-RECORD-ELEMENT>
    </ELEMENTS></APPLICATION-RECORD-DATA-TYPE>
    <APPLICATION-RECORD-DATA-TYPE><SHORT-NAME>TlvPayload</SHORT-NAME><ELEMENTS>
      <APPLICATION-RECORD-ELEMENT><SHORT-NAME>text8</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text8</TYPE-TREF>
      </APPLICATION-RECORD-ELEMENT>
      <APPLICATION-RECORD-ELEMENT><SHORT-NAME>text16</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text16</TYPE-TREF>
      </APPLICATION-RECORD-ELEMENT>
    </ELEMENTS></APPLICATION-RECORD-DATA-TYPE>
    <APPLICATION-RECORD-DATA-TYPE><SHORT-NAME>StaticTlvPayload</SHORT-NAME><ELEMENTS>
      <APPLICATION-RECORD-ELEMENT><SHORT-NAME>text8</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text8</TYPE-TREF>
      </APPLICATION-RECORD-ELEMENT>
    </ELEMENTS></APPLICATION-RECORD-DATA-TYPE>
    <DATA-TYPE-MAPPING-SET><SHORT-NAME>Mappings</SHORT-NAME><DATA-TYPE-MAPS>
      <DATA-TYPE-MAP><APPLICATION-DATA-TYPE-REF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text8</APPLICATION-DATA-TYPE-REF>
        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Features/Text8Storage</IMPLEMENTATION-DATA-TYPE-REF>
      </DATA-TYPE-MAP>
      <DATA-TYPE-MAP><APPLICATION-DATA-TYPE-REF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Features/Text16</APPLICATION-DATA-TYPE-REF>
        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Features/Text16Storage</IMPLEMENTATION-DATA-TYPE-REF>
      </DATA-TYPE-MAP>
    </DATA-TYPE-MAPS></DATA-TYPE-MAPPING-SET>
    <SERVICE-INTERFACE><SHORT-NAME>Service</SHORT-NAME><EVENTS>
      <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>Event</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/Features/Payload</TYPE-TREF>
      </VARIABLE-DATA-PROTOTYPE>
      <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>TlvEvent</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/Features/TlvPayload</TYPE-TREF>
      </VARIABLE-DATA-PROTOTYPE>
      <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>StaticTlvEvent</SHORT-NAME>
        <TYPE-TREF DEST="APPLICATION-RECORD-DATA-TYPE">/Features/StaticTlvPayload</TYPE-TREF>
      </VARIABLE-DATA-PROTOTYPE>
    </EVENTS></SERVICE-INTERFACE>
    <TLV-DATA-ID-DEFINITION-SET><SHORT-NAME>TlvDataIds</SHORT-NAME><TLV-DATA-ID-DEFINITIONS>
      <TLV-DATA-ID-DEFINITION><ID>1</ID>
        <TLV-RECORD-ELEMENT-REF DEST="APPLICATION-RECORD-ELEMENT">/Features/TlvPayload/text8</TLV-RECORD-ELEMENT-REF>
      </TLV-DATA-ID-DEFINITION>
      <TLV-DATA-ID-DEFINITION><ID>2</ID>
        <TLV-RECORD-ELEMENT-REF DEST="APPLICATION-RECORD-ELEMENT">/Features/TlvPayload/text16</TLV-RECORD-ELEMENT-REF>
      </TLV-DATA-ID-DEFINITION>
      <TLV-DATA-ID-DEFINITION><ID>1</ID>
        <TLV-RECORD-ELEMENT-REF DEST="APPLICATION-RECORD-ELEMENT">/Features/StaticTlvPayload/text8</TLV-RECORD-ELEMENT-REF>
      </TLV-DATA-ID-DEFINITION>
    </TLV-DATA-ID-DEFINITIONS></TLV-DATA-ID-DEFINITION-SET>
    <TRANSFORMATION-PROPS-SET><SHORT-NAME>Props</SHORT-NAME><TRANSFORMATION-PROPSS>
      <AP-SOMEIP-TRANSFORMATION-PROPS><SHORT-NAME>Deployment</SHORT-NAME>
        <SIZE-OF-STRING-LENGTH-FIELD>1</SIZE-OF-STRING-LENGTH-FIELD>
      </AP-SOMEIP-TRANSFORMATION-PROPS>
      <AP-SOMEIP-TRANSFORMATION-PROPS><SHORT-NAME>TlvDeployment</SHORT-NAME>
        <SIZE-OF-STRING-LENGTH-FIELD>1</SIZE-OF-STRING-LENGTH-FIELD>
        <SIZE-OF-STRUCT-LENGTH-FIELD>1</SIZE-OF-STRUCT-LENGTH-FIELD>
      </AP-SOMEIP-TRANSFORMATION-PROPS>
      <AP-SOMEIP-TRANSFORMATION-PROPS><SHORT-NAME>StaticTlvDeployment</SHORT-NAME>
        <IS-DYNAMIC-LENGTH-FIELD-SIZE>false</IS-DYNAMIC-LENGTH-FIELD-SIZE>
        <SIZE-OF-STRING-LENGTH-FIELD>1</SIZE-OF-STRING-LENGTH-FIELD>
        <SIZE-OF-STRUCT-LENGTH-FIELD>1</SIZE-OF-STRUCT-LENGTH-FIELD>
      </AP-SOMEIP-TRANSFORMATION-PROPS>
    </TRANSFORMATION-PROPSS></TRANSFORMATION-PROPS-SET>
    <TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING><SHORT-NAME>Mapping</SHORT-NAME>
      <EVENT-REFS><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Features/Service/Event</EVENT-REF></EVENT-REFS>
      <TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/Features/Props/Deployment</TRANSFORMATION-PROPS-REF>
    </TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
    <TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING><SHORT-NAME>TlvMapping</SHORT-NAME>
      <EVENT-REFS><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Features/Service/TlvEvent</EVENT-REF></EVENT-REFS>
      <TLV-DATA-ID-DEFINITION-REFS><TLV-DATA-ID-DEFINITION-REF DEST="TLV-DATA-ID-DEFINITION-SET">/Features/TlvDataIds</TLV-DATA-ID-DEFINITION-REF></TLV-DATA-ID-DEFINITION-REFS>
      <TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/Features/Props/TlvDeployment</TRANSFORMATION-PROPS-REF>
    </TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
    <TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING><SHORT-NAME>StaticTlvMapping</SHORT-NAME>
      <EVENT-REFS><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Features/Service/StaticTlvEvent</EVENT-REF></EVENT-REFS>
      <TLV-DATA-ID-DEFINITION-REFS><TLV-DATA-ID-DEFINITION-REF DEST="TLV-DATA-ID-DEFINITION-SET">/Features/TlvDataIds</TLV-DATA-ID-DEFINITION-REF></TLV-DATA-ID-DEFINITION-REFS>
      <TRANSFORMATION-PROPS-REF DEST="AP-SOMEIP-TRANSFORMATION-PROPS">/Features/Props/StaticTlvDeployment</TRANSFORMATION-PROPS-REF>
    </TRANSFORMATION-PROPS-TO-SERVICE-INTERFACE-ELEMENT-MAPPING>
  </ELEMENTS></AR-PACKAGE></AR-PACKAGES>
</AUTOSAR>
