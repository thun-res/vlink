        <mxCell id="sCb" value="callback(msg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1b5e20;arcSize=10;shadow=0;" vertex="1" parent="1">
