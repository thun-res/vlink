        </mxCell>
        <mxCell id="subtitle" value="Plaintext is encrypted before transport; decrypted on delivery using the same shared key" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontStyle=2;fontColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="30" y="58" width="1120" height="22" as="geometry" />
