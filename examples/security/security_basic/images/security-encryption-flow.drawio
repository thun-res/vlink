        <mxCell id="title" value="Security Encryption Pipeline  -  AES-128-GCM AEAD" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
