        </mxCell>
        <mxCell id="po2" value="sub.listen([&amp;pub](const Bytes&amp; data){&#10;  pub.publish(data);   // echo back&#10;})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976d2;strokeColor=#0d47a1;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="720" y="288" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="po3" value="message_loop.run()&#10;// blocks until Ctrl+C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
