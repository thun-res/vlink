        <mxCell id="po1" value="Subscriber&lt;Bytes&gt; sub(get_ping_url())&#10;Publisher&lt;Bytes&gt;  pub(get_pong_url())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
