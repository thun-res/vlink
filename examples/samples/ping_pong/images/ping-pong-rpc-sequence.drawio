        </mxCell>
        <mxCell id="po4" value="// shm:// path:  const Bytes&amp; may&#10;//   alias shared memory  -  no copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#ef6c00;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=2;fontColor=#e65100;dashed=1;" vertex="1" parent="1">
