        <mxCell id="title" value="Ping  -  Pong  -  Round-Trip Latency Measurement" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1080" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two Publisher  /  Subscriber pairs over distinct topics  &#183;  payload reused via Bytes::create(N)  &#183;  RTT / 2 is a one-way estimate assuming symmetry" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontStyle=2;fontColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="20" y="56" width="1080" height="22" as="geometry" />
        </mxCell>

        <mxCell id="ping_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;strokeWidth=1.5;arcSize=4;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="500" as="geometry" />
        </mxCell>
        <mxCell id="ping_bar" value="Ping Process  ( sample_ping )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976d2;strokeColor=#0d47a1;arcSize=12;shadow=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#ffffff;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="Bytes data = Bytes::create(test_size)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="340" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Publisher&lt;Bytes&gt; pub(get_ping_url())&#10;Subscriber&lt;Bytes&gt; sub(get_pong_url())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="60" y="208" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="start_stamp = steady_clock::now()&#10;( atomic timestamp )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976d2;strokeColor=#0d47a1;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="pub.publish(data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="60" y="332" width="340" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Timer t; t.attach(&amp;message_loop)&#10;t.set_interval(1000)&#10;t.set_loop_count(Timer::kInfinite)&#10;t.start(send_func)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="sub.listen([&amp;](const Bytes&amp;){&#10;  auto rtt = now() - start_stamp.load();&#10;  delay_ms = rtt.count() / 2000.0;&#10;})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976d2;strokeColor=#0d47a1;arcSize=10;strokeWidth=1.2;shadow=0;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="472" width="340" height="96" as="geometry" />
        </mxCell>

        <mxCell id="pong_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;strokeWidth=1.5;arcSize=4;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="380" height="500" as="geometry" />
        </mxCell>
        <mxCell id="pong_bar" value="Pong Process  ( sample_pong )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976d2;strokeColor=#0d47a1;arcSize=12;shadow=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#ffffff;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="380" height="40" as="geometry" />
