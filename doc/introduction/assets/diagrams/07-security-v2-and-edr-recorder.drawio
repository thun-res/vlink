          <mxGeometry x="48" y="560" width="264" height="114" as="geometry" />
        </mxCell>
        <mxCell id="36" value="&lt;div style='line-height:1.32;'&gt;&lt;b style='font-size:9.6px;color:#0D47A1;'&gt;国密 SM2/SM4 与硬件 HSM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8.5px;color:#546E7A;'&gt;提供 encrypt/decrypt 自定义回调&lt;br&gt;可不链接 OpenSSL，满足合规接入&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
