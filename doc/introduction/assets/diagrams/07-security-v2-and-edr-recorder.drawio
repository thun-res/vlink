        <mxCell id="24" value="&lt;div style='line-height:1.32;'&gt;&lt;b style='font-size:8.6px;color:#BF360C;'&gt;1. 验签&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:7.6px;color:#546E7A;'&gt;RSA-PSS-SHA256&lt;br&gt;RSA &amp;gt;= 2048&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
