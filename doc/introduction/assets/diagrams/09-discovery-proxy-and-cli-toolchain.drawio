        </mxCell>
        <mxCell id="29" value="ProxyServer (vlink-proxy) &amp;amp; Discovery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=36;fillColor=#EF6C00;strokeColor=#F57C00;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="716" y="80" width="432" height="28" as="geometry" />
        </mxCell>
        <mxCell id="30" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.3;fontColor=#263238;fontSize=10.5;fontStyle=0;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="122" width="400" height="68" as="geometry" />
        </mxCell>
        <mxCell id="31" value="&lt;div style='line-height:1.32;'&gt;&lt;b style='font-size:9.2px;color:#0D47A1;'&gt;DiscoveryReporter / DiscoveryViewer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:8.2px;color:#546E7A;'&gt;UDP 组播 239.255.0.100:29694+domain · 500ms · 1450B 打包&lt;br&gt;native 回放绑 127.0.0.1 + TTL=0，不污染局域网实车&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="122" width="400" height="68" as="geometry" />
        </mxCell>
        <mxCell id="32" value="四层 bridge=1 防回环机制（阻止跨网双向桥接发布风暴）&lt;br&gt;1. 镜像发布端设置节点属性 pub-&amp;gt;set_property(&quot;proxy.bridge&quot;, &quot;1&quot;)&lt;br&gt;2. DiscoveryReporter 在 UDP 宣告报文末尾透传 bridge=1 标记&lt;br&gt;3. ProxyServer::update_all() 剥离 bridge 进程发布角色 (type &amp;amp;= ~kPublisher)&lt;br&gt;4. 反向订阅关发现 (set_discovery_enabled(false)) + 同机跳过 SHM 镜像" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#F57C00;strokeWidth=1.4;fontColor=#BF360C;fontSize=8.4;fontStyle=0;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="202" width="400" height="128" as="geometry" />
        </mxCell>
        <mxCell id="33" value="运维辅助：--config JSON · 内嵌托管 Iceoryx RouDi (--iox_strategy 1..4)&lt;br&gt;支持 --runnable 加载 RunablePluginInterface 独立业务插件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.4;fontColor=#37474F;fontSize=8.4;fontStyle=0;fontFamily=Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="732" y="342" width="400" height="66" as="geometry" />
        </mxCell>
