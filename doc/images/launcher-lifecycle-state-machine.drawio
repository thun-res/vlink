        </mxCell>
        <mxCell id="notes_l1" value="Component Standby:  kInactive holds configured resources (on_configure done); ctl activate transitions to kReady without reload." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#37474f;" vertex="1" parent="1">
