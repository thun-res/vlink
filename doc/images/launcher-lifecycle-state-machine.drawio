        <mxCell id="notes_l0" value="Cold Boot Spine:  kPending -&amp;gt; kStarting -&amp;gt; kRunning -&amp;gt; kReady (or kStopped for completed oneshot [[task]])." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#37474f;" vertex="1" parent="1">
