        </mxCell>
        <mxCell id="notes_l2" value="Failure &amp;amp; Respawn:  exit crash, ready timeout, liveness or watchdog timeout enters kFailed or kRestarting (bounded by start_limit_burst)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#37474f;" vertex="1" parent="1">
          <mxGeometry x="56" y="642" width="1008" height="18" as="geometry" />
        </mxCell>
        <mxCell id="notes_l3" value="Graceful Stop:  kStopping drains in-flight ComponentHost task guards or sends stop_signal -&amp;gt; SIGKILL within sigterm_timeout_ms." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#37474f;" vertex="1" parent="1">
