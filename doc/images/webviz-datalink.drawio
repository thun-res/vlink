        </mxCell>
        <mxCell id="note2" value="Subscription Flow (Rerun)&#10;1. RerunServer requests every discovered URL&#10;2. DataCallback calls convert_and_log() once&#10;3. Converter resolves mappings and logs results&#10;4. Rerun SDK streams online output over gRPC" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=10;fontColor=#0d47a1;align=left;fontStyle=1;shadow=0;fontFamily=Helvetica;" vertex="1" parent="1">
