        <!-- Notes -->
        <mxCell id="note1" value="Subscription Flow (Foxglove)&#10;1. Studio changes channel subscriptions (WS)&#10;2. Server rebuilds the kAuto url_meta_list&#10;3. bridge send_control(control, false)&#10;4. DataCallback -&gt; convert() -&gt; WS binary frame" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;fontColor=#1b5e20;align=left;fontStyle=1;shadow=0;fontFamily=Helvetica;" vertex="1" parent="1">
