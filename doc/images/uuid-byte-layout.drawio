        <mxCell id="title" value="vlink::Uuid -- RFC 4122 128-bit Byte Layout" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="70" y="24" width="1260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="16 bytes in network byte order · octet 6 stores version bits · octet 8 stores variant bits" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontStyle=2;fontColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="70" y="58" width="1260" height="24" as="geometry" />
