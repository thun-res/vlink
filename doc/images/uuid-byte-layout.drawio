        </mxCell>
        <mxCell id="size_note" value="sizeof(Uuid) = 16 B · kStringSize = 36 canonical chars · compact form = 32 hex chars" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;fontColor=#37474f;" vertex="1" parent="1">
          <mxGeometry x="90" y="124" width="660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="source_note" value="generate_random(): std::mt19937 bytes, then data[6] = (data[6] &amp; 0x0F) | 0x40 and data[8] = (data[8] &amp; 0x3F) | 0x80" style="text;html=1;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#546e7a;" vertex="1" parent="1">
