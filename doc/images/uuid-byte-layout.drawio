        <mxCell id="version_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;strokeWidth=1.6;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="590" height="292" as="geometry" />
        </mxCell>
        <mxCell id="version_title" value="octet 6: UUID version (high 4 bits)" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="110" y="396" width="550" height="24" as="geometry" />
        </mxCell>
        <mxCell id="version_mask" value="mask used by generate_random(): (data[6] &amp; 0x0F) | 0x40" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontFamily=monospace;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="110" y="428" width="550" height="22" as="geometry" />
        </mxCell>
        <mxCell id="version_rows" value="0001 xxxx = kTimeBased (v1)&lt;br&gt;0010 xxxx = kDceSecurity (v2)&lt;br&gt;0011 xxxx = kNameBasedMd5 (v3)&lt;br&gt;&lt;b&gt;0100 xxxx = kRandomBased (v4)  -- Uuid::generate_random()&lt;/b&gt;&lt;br&gt;0101 xxxx = kNameBasedSha1 (v5)&lt;br&gt;other = kNone (nil UUID or invalid version nibble)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingTop=8;strokeColor=none;fillColor=none;fontSize=13;fontFamily=monospace;fontColor=#6a1b9a;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="464" width="520" height="166" as="geometry" />
        </mxCell>

        <mxCell id="variant_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=1.6;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="590" height="292" as="geometry" />
        </mxCell>
        <mxCell id="variant_title" value="octet 8: UUID variant (high bits)" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="740" y="396" width="550" height="24" as="geometry" />
        </mxCell>
        <mxCell id="variant_mask" value="mask used by generate_random(): (data[8] &amp; 0x3F) | 0x80" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontFamily=monospace;fontColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="740" y="428" width="550" height="22" as="geometry" />
        </mxCell>
        <mxCell id="variant_rows" value="0xxx xxxx = kNcs (NCS compatibility)&lt;br&gt;&lt;b&gt;10xx xxxx = kRfc (RFC 4122 / DCE 1.1)  -- v4 output&lt;/b&gt;&lt;br&gt;110x xxxx = kMicrosoft (COM GUID)&lt;br&gt;111x xxxx = kReserved" style="text;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingTop=8;strokeColor=none;fillColor=none;fontSize=13;fontFamily=monospace;fontColor=#bf360c;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="750" y="464" width="520" height="118" as="geometry" />
        </mxCell>
        <mxCell id="variant_note" value="variant() checks data[8] with 0x80, 0xC0 and 0xE0 masks; random v4 generation always forces the RFC 4122 10xx pattern." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;strokeColor=none;fillColor=none;fontSize=12;fontStyle=2;fontColor=#bf360c;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="750" y="602" width="520" height="44" as="geometry" />
        </mxCell>

